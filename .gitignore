!/plan-travel.js
!/notice-import.js
!/notice-review.js
!/styles.css
!/README.md
!/THIRD_PARTY_NOTICES.md
!/vendor/
!/assets/

# Never add project inputs, generated records, or credentials.
*.xlsx
*.xls
*.doc
*.docx
*.pdf
*.zip
*.png
*.jpg
*.log
.env*
node_modules/
output/
outputs/
_source_extract/
_sample_extract/
/assets/*
!/assets/head-certification-logo.png
